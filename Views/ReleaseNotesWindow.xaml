<Window x:Class="GHPC_Mod_Manager.Views.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:GHPC_Mod_Manager.Resources"
        xmlns:controls="clr-namespace:GHPC_Mod_Manager.Views.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{x:Static resources:Strings.ReleaseNotesTitle}"
        Width="820"
        Height="700"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Grid.Row="0"/>

        <Border Grid.Row="1"
                Margin="20,16,20,12"
                Padding="8"
                Background="{DynamicResource SurfaceBrush}"
                Style="{StaticResource PageSurfaceCardStyle}">
            <wv2:WebView2 x:Name="ReleaseNotesWebView"/>
        </Border>

        <Button Grid.Row="2"
                Content="{x:Static resources:Strings.Close}"
                MinWidth="110"
                Margin="20,0,20,16"
                HorizontalAlignment="Right"
                Style="{DynamicResource FilledButtonStyle}"
                Click="CloseButton_Click"/>
    </Grid>
</Window>

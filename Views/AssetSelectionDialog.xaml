<Window x:Class="GHPC_Mod_Manager.Views.AssetSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:GHPC_Mod_Manager.Resources"
        Title="{x:Static resources:Strings.AssetSelectionTitle}"
        Width="620"
        MinWidth="500"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Margin="12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource OutlineVariantBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Effect="{StaticResource CardShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="20,16,20,12"
                    Background="{DynamicResource SurfaceContainerBrush}"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <Path Data="{StaticResource IconQuestion}"
                          Width="26"
                          Height="26"
                          Margin="0,0,12,0"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="2"
                          Fill="Transparent"
                          Stretch="Uniform"
                          DockPanel.Dock="Left"/>
                    <TextBlock Text="{x:Static resources:Strings.AssetSelectionTitle}"
                               FontFamily="{DynamicResource DefaultFontFamily}"
                               FontSize="{DynamicResource TitleSmall}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OnSurfaceBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,16,20,8">
                <TextBlock x:Name="MessageText"
                           FontFamily="{DynamicResource DefaultFontFamily}"
                           FontSize="{DynamicResource BodyMedium}"
                           Foreground="{DynamicResource OnSurfaceBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{x:Static resources:Strings.AssetSelectionHint}"
                           Margin="0,8,0,0"
                           FontFamily="{DynamicResource DefaultFontFamily}"
                           FontSize="{DynamicResource BodySmall}"
                           Foreground="{DynamicResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <ListBox x:Name="AssetList"
                     Grid.Row="2"
                     Margin="20,8,20,12"
                     MaxHeight="360"
                     BorderThickness="0"
                     Background="Transparent"
                     SelectionChanged="AssetList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                Background="{DynamicResource SurfaceContainerBrush}"
                                BorderBrush="{DynamicResource OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSmall}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="{DynamicResource MonospaceFontFamily}"
                                               FontSize="{DynamicResource BodyMedium}"
                                               Foreground="{DynamicResource OnSurfaceBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SizeDisplay}"
                                               Margin="0,4,0,0"
                                               FontFamily="{DynamicResource DefaultFontFamily}"
                                               FontSize="{DynamicResource BodySmall}"
                                               Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding RecommendationDisplay}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource DefaultFontFamily}"
                                           FontSize="{DynamicResource LabelMedium}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="3"
                    Padding="20,12,20,16"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="0,0,16,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static resources:Strings.Cancel}"
                            Style="{StaticResource OutlinedButtonStyle}"
                            MinWidth="80"
                            Click="Cancel_Click"/>
                    <Button x:Name="ConfirmButton"
                            Content="{x:Static resources:Strings.OK}"
                            Style="{StaticResource FilledButtonStyle}"
                            MinWidth="80"
                            Margin="8,0,0,0"
                            Click="Confirm_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

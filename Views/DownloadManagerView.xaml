<UserControl x:Class="GHPC_Mod_Manager.Views.DownloadManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GHPC_Mod_Manager.Views.Controls"
             xmlns:converters="clr-namespace:GHPC_Mod_Manager.Converters">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="QueueActionButton" TargetType="Button" BasedOn="{StaticResource OutlinedButtonStyle}">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style x:Key="QueueMetaText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource BodySmall}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource CanvasBrush}" Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceContainerBrush}"
                BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SpeedLabel}" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               FontSize="{DynamicResource LabelLarge}"/>
                    <TextBlock Text="{Binding CurrentSpeed}" Foreground="{DynamicResource OnSurfaceBrush}"
                               FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding QueueTitle}" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>
                <controls:SpeedGraphControl Grid.Column="1" Samples="{Binding SpeedSamples}"
                                            DataContext="{Binding}" Height="96" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding PauseAllLabel}" Command="{Binding PauseAllCommand}" Style="{StaticResource QueueActionButton}"/>
                <Button Content="{Binding ResumeAllLabel}" Command="{Binding ResumeAllCommand}" Style="{StaticResource QueueActionButton}"/>
                <Button Content="{Binding CancelAllLabel}" Command="{Binding CancelAllCommand}" Style="{StaticResource QueueActionButton}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ConcurrencyLabel}" Style="{StaticResource QueueMetaText}" Margin="0,0,8,0"/>
                <ComboBox Width="72" SelectedValue="{Binding MaxConcurrentDownloads, Mode=TwoWay}"
                          SelectedValuePath="Content" Foreground="{DynamicResource OnSurfaceBrush}"
                          Background="{DynamicResource SurfaceBrush}">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>            

            <Grid Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}"
                                    BorderThickness="0,0,0,1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="160"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- 行1：标题 + 操作按钮 -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right">
                                                <Button ToolTip="{Binding DataContext.MoveUpLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanMove, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource QueueActionButton}" Padding="6,5" MinWidth="28">
                                                    <Path Data="{StaticResource IconMoveUp}" Stroke="{DynamicResource OnSurfaceBrush}"
                                                          StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                                <Button ToolTip="{Binding DataContext.MoveDownLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanMove, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource QueueActionButton}" Padding="6,5" MinWidth="28">
                                                    <Path Data="{StaticResource IconMoveDown}" Stroke="{DynamicResource OnSurfaceBrush}"
                                                          StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                                <Button ToolTip="{Binding DataContext.PauseLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource QueueActionButton}" Padding="6,5" MinWidth="28">
                                                    <Path Data="{StaticResource IconPause}" Fill="{DynamicResource OnSurfaceBrush}"
                                                          Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                                <Button ToolTip="{Binding DataContext.ResumeLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource QueueActionButton}" Padding="6,5" MinWidth="28">
                                                    <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource OnSurfaceBrush}"
                                                          Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                                <Button ToolTip="{Binding DataContext.RetryLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource QueueActionButton}" Padding="6,5" MinWidth="28">
                                                    <Path Data="{StaticResource IconRetry}" Stroke="{DynamicResource OnSurfaceBrush}"
                                                          StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                                <Button ToolTip="{Binding DataContext.RemoveLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource QueueActionButton}" Padding="6,5" MinWidth="28" Margin="0">
                                                    <Path Data="{StaticResource IconDelete}" Stroke="{DynamicResource OnSurfaceBrush}"
                                                          StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                                <Button ToolTip="{Binding DataContext.CancelLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource QueueActionButton}" Padding="6,5" MinWidth="28" Margin="0">
                                                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource OnSurfaceBrush}"
                                                          StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                            </WrapPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource OnSurfaceBrush}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.ToolTip>
                                                        <TextBlock Text="{Binding DisplayTitle}"/>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>
                                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource QueueMetaText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- 行2：进度条（放大居中，突出显示） -->
                                        <controls:ChunkProgressBar Grid.Row="1"
                                                                    Height="12"
                                                                    Margin="0,2,0,4"
                                                                    Segments="{Binding ChunkSegments}"
                                                                    TotalBytes="{Binding TotalBytes}"
                                                                    SimpleProgress="{Binding Progress}"
                                                                    CompletedBrush="{DynamicResource AccentBrush}"
                                                                    DownloadingBrush="{DynamicResource SecondaryContainerBrush}"
                                                                    TrackBrush="{DynamicResource SurfaceContainerBrush}"
                                                                    CornerRadius="4"/>

                                        <!-- 行3：状态文字 -->
                                        <DockPanel Grid.Row="2">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource QueueMetaText}"/>
                                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource QueueMetaText}"
                                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource QueueMetaText}"
                                                       DockPanel.Dock="Right" TextAlignment="Right"/>
                                        </DockPanel>

                                        <!-- 错误信息 -->
                                        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding EmptyLabel}" Foreground="{DynamicResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource BodyLarge}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
